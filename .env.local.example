# Supabase project settings (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — full DB bypass access. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Fixed fake domain used to turn a free-form username into a Supabase Auth email
# (e.g. "dana" -> "dana@staff.local"). Must never be a real, resolvable domain.
# Public on purpose — the login page (browser) has to build the same address to sign in.
NEXT_PUBLIC_INTERNAL_AUTH_DOMAIN=staff.local

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" — generate a random string.
CRON_SECRET=

# Optional — reminders run in "skipped/log" mode until this is set.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=reminders@example.com
